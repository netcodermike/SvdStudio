<UserControl x:Class="SvdStudio.Controls.HeatmapMatrixControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:SvdStudio.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <Border Background="#1E2230" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <Border Background="#334155" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DimensionsBadge}" FontSize="11" FontWeight="Medium" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- Format Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Fmt:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox SelectedValue="{Binding NumberFormat, Mode=TwoWay}" SelectedValuePath="Tag"
                              Background="#0F172A" Foreground="#CBD5E1" BorderBrush="#334155" FontSize="11" Height="24" Width="60">
                        <ComboBoxItem Content="G4" Tag="G4"/>
                        <ComboBoxItem Content="G6" Tag="G6" IsSelected="True"/>
                        <ComboBoxItem Content="F2" Tag="F2"/>
                        <ComboBoxItem Content="F4" Tag="F4"/>
                        <ComboBoxItem Content="E2" Tag="E2"/>
                    </ComboBox>
                </StackPanel>

                <!-- Copy Menu Button -->
                <Menu Grid.Column="2" Background="Transparent">
                    <MenuItem Header="📋 Copy" Background="#3B82F6" Foreground="White" FontWeight="Medium"
                              Padding="8,4" BorderThickness="0">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#2563EB" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="📋 Copy" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </ControlTemplate>
                        </MenuItem.Template>
                        <MenuItem Header="Copy as CSV" Command="{Binding CopyCsvCommand}"/>
                        <MenuItem Header="Copy as LaTeX (\begin{bmatrix})" Command="{Binding CopyLatexCommand}"/>
                        <MenuItem Header="Copy as MATLAB [1 2; 3 4]" Command="{Binding CopyMatlabCommand}"/>
                        <MenuItem Header="Copy as JSON 2D Array" Command="{Binding CopyJsonCommand}"/>
                    </MenuItem>
                </Menu>
            </Grid>

            <!-- Matrix Scrollable Grid -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Column Headers -->
                    <ItemsControl ItemsSource="{Binding ColumnHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Margin="42,0,0,4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="64" Height="20" Margin="2,0" Background="#161B26" CornerRadius="3">
                                    <TextBlock Text="{Binding}" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Matrix Rows -->
                    <ItemsControl ItemsSource="{Binding RowsList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <!-- Row Header -->
                                    <Border Width="40" Height="28" Background="#161B26" CornerRadius="3" Margin="0,0,2,0">
                                        <TextBlock Text="{Binding HeaderText}" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Cells in this row -->
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="64" Height="28" Margin="2,0"
                                                        Background="{Binding BackgroundBrush}"
                                                        BorderBrush="#252D3F" BorderThickness="1"
                                                        CornerRadius="4"
                                                        ToolTipService.InitialShowDelay="100">
                                                    <Border.ToolTip>
                                                        <ToolTip Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#3B82F6">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Value, StringFormat='Value: {0:R}'}" FontWeight="Medium"/>
                                                                <TextBlock Text="{Binding Row, StringFormat='Row: {0}'}" FontSize="10" Foreground="#94A3B8"/>
                                                                <TextBlock Text="{Binding Column, StringFormat='Col: {0}'}" FontSize="10" Foreground="#94A3B8"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <TextBlock Text="{Binding FormattedText}"
                                                               Foreground="{Binding ForegroundBrush}"
                                                               FontSize="11"
                                                               FontFamily="Cascadia Code, Consolas, Segoe UI Mono"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
