<Window x:Class="SvdStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SvdStudio"
        xmlns:controls="clr-namespace:SvdStudio.Controls"
        xmlns:vm="clr-namespace:SvdStudio.ViewModels"
        mc:Ignorable="d"
        Title="SVD Studio - Singular Value Decomposition Engine" Height="820" Width="1280"
        MinHeight="650" MinWidth="950"
        Background="#0B0F19" Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="#161B26" BorderBrush="#2E364F" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="Σ" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SVD Studio" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0 • .NET 8" FontSize="10" FontWeight="Medium" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Singular Value Decomposition Engine for Any Matrix" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Presets & Quick Tools -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Preset:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              DisplayMemberPath="Name" Width="210" Height="28"
                              Background="#1E2230" Foreground="#E2E8F0" BorderBrush="#334155" FontSize="12" Margin="0,0,16,0"/>

                    <!-- SVD Mode Toggle -->
                    <Border Background="#1E2230" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Thin / Economy" IsChecked="{Binding IsEconomy, Mode=TwoWay}"
                                         Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" Margin="6,3" VerticalAlignment="Center"/>
                            <RadioButton Content="Full SVD" IsChecked="{Binding IsEconomy, Mode=TwoWay, Converter={StaticResource InverseBoolToVis}}"
                                         Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" Margin="6,3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 Import Matrix..." Command="{Binding ImportFileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="📄 Export Report..." Command="{Binding ExportSummaryCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SPLIT WORKSPACE -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <!-- Left Input & Metrics Panel -->
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="450"/>
                <ColumnDefinition Width="14"/>
                <!-- Right Tabs Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Matrix Input & Diagnostics -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Input Matrix Card -->
                    <Border Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Matrix Input (A)" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding MatrixDimensionText, StringFormat='Size: {0}'}" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Paste values (space, tab, CSV, MATLAB [1 2; 3 4], or JSON):"
                                       FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6" TextWrapping="Wrap"/>

                            <!-- Code / Matrix Input Box -->
                            <TextBox Text="{Binding InputMatrixText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Height="130"
                                     Background="#0B0F19" Foreground="#38BDF8"
                                     FontFamily="Cascadia Code, Consolas, Segoe UI Mono" FontSize="12"
                                     BorderBrush="#2E364F" BorderThickness="1" Padding="8" Margin="0,0,0,10"/>

                            <!-- Error Message Banner -->
                            <Border Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠ " Foreground="#F87171" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Actions Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⚡ Decompose Matrix" Command="{Binding ComputeSvdCommand}"
                                        Height="32" Background="#2563EB" FontWeight="Bold" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearInputCommand}"
                                        Style="{StaticResource SecondaryButton}" Height="32" Width="60"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Decomposition Equation Badge -->
                    <Border Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SVD Factorization Equation" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" Margin="0,0,0,8"/>

                            <!-- Equation Layout -->
                            <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="A  =  U  ·  Σ  ·  Vᵀ" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="[m × n] = [m × k] · [k × k] · [k × n]" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Dimension Badges Grid -->
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <Border Background="#1E2230" CornerRadius="4" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Matrix A" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding MatrixDimensionText}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1E2230" CornerRadius="4" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Left Vectors U" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding UDimensionText}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1E2230" CornerRadius="4" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Singular Values Σ" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SDimensionText}" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1E2230" CornerRadius="4" Padding="6,4" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="Right Vectors Vᵀ" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding VTDimensionText}" FontSize="12" FontWeight="SemiBold" Foreground="#A855F7"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Key Matrix Metrics Card -->
                    <Border Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Spectral &amp; Numerical Invariants" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" Margin="0,0,0,8"/>

                            <!-- Rank and Condition Number -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#064E3B" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Numerical Rank" FontSize="10" Foreground="#6EE7B7"/>
                                        <TextBlock Text="{Binding Rank, StringFormat='r = {0}'}" FontSize="15" FontWeight="Bold" Foreground="#34D399"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#1E2230" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Condition Number κ" FontSize="10" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding ConditionNumber, Converter={StaticResource ConditionNumberFormat}}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Invariant Metrics List -->
                            <Grid Margin="0,3">
                                <TextBlock Text="Frobenius Norm ||A||_F" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding FrobeniusNorm, StringFormat='{}{0:G5}'}" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Spectral Norm ||A||₂ (σ₁)" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding SpectralNorm, StringFormat='{}{0:G5}'}" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Nuclear Norm ||A||* (Σ σᵢ)" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding NuclearNorm, StringFormat='{}{0:G5}'}" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Determinant (Square)" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding DeterminantText}" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Reconstruction Error" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding ReconstructionError, StringFormat='{}{0:E3}'}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Orthogonality ||UᵀU - I||" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding OrthogonalityErrorU, StringFormat='{}{0:E3}'}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Orthogonality ||VᵀV - I||" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding OrthogonalityErrorV, StringFormat='{}{0:E3}'}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Random Matrix Generator (Expander) -->
                    <Expander Header="🎲 Random Matrix Generator" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"
                              Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" Padding="6">
                        <StackPanel Margin="6,8,6,4">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Rows (m):" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding RandomRows, Mode=TwoWay}" Height="24" Background="#0B0F19" Foreground="White" BorderBrush="#334155" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Cols (n):" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding RandomCols, Mode=TwoWay}" Height="24" Background="#0B0F19" Foreground="White" BorderBrush="#334155" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Min Value:" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding RandomMin, Mode=TwoWay}" Height="24" Background="#0B0F19" Foreground="White" BorderBrush="#334155" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Max Value:" FontSize="10" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding RandomMax, Mode=TwoWay}" Height="24" Background="#0B0F19" Foreground="White" BorderBrush="#334155" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Integer Values Only" IsChecked="{Binding RandomIntegerOnly, Mode=TwoWay}"
                                      Foreground="#94A3B8" FontSize="11" Margin="0,0,0,8"/>

                            <Button Content="Generate Random Matrix" Command="{Binding GenerateRandomCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="28"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT MAIN PANEL: Tabs & Visualizations -->
            <TabControl Grid.Column="2">

                <!-- TAB 1: SVD Factors (U, S, V^T, Reconstructed) -->
                <TabItem Header="📐 Factorization (U, Σ, Vᵀ)">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sub-Navigation for Factors -->
                        <Border Grid.Row="0" Background="#161B26" CornerRadius="8" Padding="6" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <RadioButton x:Name="RbFactorU" Content="Left Vectors U" IsChecked="True" GroupName="Factors"
                                             Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Margin="10,4"/>
                                <RadioButton x:Name="RbFactorS" Content="Singular Values Σ" GroupName="Factors"
                                             Foreground="#F59E0B" FontWeight="SemiBold" FontSize="12" Margin="10,4"/>
                                <RadioButton x:Name="RbFactorVT" Content="Right Vectors Vᵀ" GroupName="Factors"
                                             Foreground="#A855F7" FontWeight="SemiBold" FontSize="12" Margin="10,4"/>
                                <RadioButton x:Name="RbFactorV" Content="Right Vectors V" GroupName="Factors"
                                             Foreground="#A855F7" FontWeight="SemiBold" FontSize="12" Margin="10,4"/>
                                <RadioButton x:Name="RbFactorA" Content="Input Matrix A" GroupName="Factors"
                                             Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12" Margin="10,4"/>
                                <RadioButton x:Name="RbFactorRec" Content="Reconstructed A'" GroupName="Factors"
                                             Foreground="#34D399" FontWeight="SemiBold" FontSize="12" Margin="10,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Factor Display Area -->
                        <Grid Grid.Row="1">
                            <controls:HeatmapMatrixControl DataContext="{Binding MatrixU}"
                                                           Visibility="{Binding IsChecked, ElementName=RbFactorU, Converter={StaticResource BoolToVis}}"/>

                            <controls:HeatmapMatrixControl DataContext="{Binding MatrixS}"
                                                           Visibility="{Binding IsChecked, ElementName=RbFactorS, Converter={StaticResource BoolToVis}}"/>

                            <controls:HeatmapMatrixControl DataContext="{Binding MatrixVT}"
                                                           Visibility="{Binding IsChecked, ElementName=RbFactorVT, Converter={StaticResource BoolToVis}}"/>

                            <controls:HeatmapMatrixControl DataContext="{Binding MatrixV}"
                                                           Visibility="{Binding IsChecked, ElementName=RbFactorV, Converter={StaticResource BoolToVis}}"/>

                            <controls:HeatmapMatrixControl DataContext="{Binding MatrixA}"
                                                           Visibility="{Binding IsChecked, ElementName=RbFactorA, Converter={StaticResource BoolToVis}}"/>

                            <controls:HeatmapMatrixControl DataContext="{Binding MatrixReconstructed}"
                                                           Visibility="{Binding IsChecked, ElementName=RbFactorRec, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Spectral & Scree Plot -->
                <TabItem Header="📊 Spectral &amp; Scree Plot">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="250"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Scree Plot Visualizer -->
                        <controls:ScreePlotControl Grid.Row="0" ItemsSource="{Binding SingularValueItems}"/>

                        <!-- Bottom: Singular Values Table & Pseudo-Inverse -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Singular Values Table -->
                            <Border Grid.Column="0" Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Singular Values Spectrum" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" Margin="0,0,0,8"/>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding SingularValueItems}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                              Background="Transparent" RowBackground="#1E2230" AlternatingRowBackground="#161B26"
                                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2E364F"
                                              Foreground="#E2E8F0" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Index" Binding="{Binding Name}" Width="60"/>
                                            <DataGridTextColumn Header="Singular Value (σᵢ)" Binding="{Binding FormattedValue}" Width="*"/>
                                            <DataGridTextColumn Header="Energy %" Binding="{Binding FormattedEnergy}" Width="85"/>
                                            <DataGridTextColumn Header="Cumulative %" Binding="{Binding FormattedCumulative}" Width="95"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- Moore-Penrose Pseudo-Inverse A+ -->
                            <controls:HeatmapMatrixControl Grid.Column="2" DataContext="{Binding MatrixPInv}"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 3: Truncated SVD / Low-Rank Approximations -->
                <TabItem Header="📉 Low-Rank Approx (Truncated)">
                    <Grid Margin="0,10,0,0" DataContext="{Binding TruncatedSvd}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Controls Bar: Rank Slider & Metrics -->
                        <Border Grid.Row="0" Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Slider Column -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Target Rank (k): " FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="{Binding TargetRank}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding MaxRank, StringFormat=' / {0}'}" FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <Slider Minimum="1" Maximum="{Binding MaxRank}" Value="{Binding TargetRank, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Retained Energy Gauge & Error -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Captured Energy (Variance)" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding EnergyPercentage, StringFormat='{}{0:F2}%'}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Frobenius Error ||A - A_k||" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding FrobeniusError, StringFormat='{}{0:G5}'}" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6">
                                        <StackPanel>
                                            <TextBlock Text="Relative Error" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding RelativeErrorPercent, StringFormat='{}{0:F2}%'}" FontSize="14" FontWeight="SemiBold" Foreground="#F43F5E"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Mode Selector for Rank-1 Decomposition -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Inspect Rank-1 Mode:" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding Rank1ModeNames}" SelectedIndex="{Binding SelectedRank1Index, Mode=TwoWay}"
                                              Width="160" Height="26" Background="#1E2230" Foreground="#CBD5E1" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Matrices Display: Approximation Ak & Difference -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <controls:HeatmapMatrixControl Grid.Column="0" DataContext="{Binding ApproxDisplay}"/>
                            <controls:HeatmapMatrixControl Grid.Column="2" DataContext="{Binding DiffDisplay}"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 4: 2D Geometric Transformation Visualizer -->
                <TabItem Header="🔄 2D Geometric Action">
                    <Grid Margin="0,10,0,0" DataContext="{Binding Geometric2D}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Explanation Card -->
                        <Border Grid.Row="0" Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Geometric Interpretation of SVD" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="SVD decomposes any transformation into rotation (Vᵀ), stretching (Σ), and rotation (U). The unit circle is mapped directly onto a rotated ellipse whose semi-axes lengths are the singular values σ₁, σ₂ aligned with u₁, u₂!"
                                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6">
                                        <TextBlock Text="{Binding AreaScalingText}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Canvas Visualizer & Coordinate Readout -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <controls:GeometricTransformControl Grid.Column="0"/>

                            <!-- Vector Readout Sidebar -->
                            <Border Grid.Column="2" Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Vector Coordinates" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10"/>

                                    <TextBlock Text="Domain (Right Singular):" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border Background="#1E2230" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding VectorV1Text}" FontSize="12" FontFamily="Cascadia Code, Consolas" Foreground="#E2E8F0"/>
                                    </Border>
                                    <Border Background="#1E2230" CornerRadius="4" Padding="8,4" Margin="0,0,0,14">
                                        <TextBlock Text="{Binding VectorV2Text}" FontSize="12" FontFamily="Cascadia Code, Consolas" Foreground="#E2E8F0"/>
                                    </Border>

                                    <TextBlock Text="Codomain (Ellipse Semi-Axes):" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border Background="#1E2230" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding VectorU1Text}" FontSize="12" FontFamily="Cascadia Code, Consolas" Foreground="#E2E8F0"/>
                                    </Border>
                                    <Border Background="#1E2230" CornerRadius="4" Padding="8,4" Margin="0,0,0,14">
                                        <TextBlock Text="{Binding VectorU2Text}" FontSize="12" FontFamily="Cascadia Code, Consolas" Foreground="#E2E8F0"/>
                                    </Border>

                                    <TextBlock Text="Mathematical Theorem:" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="A · v₁ = σ₁ · u₁&#x0a;A · v₂ = σ₂ · u₂"
                                               FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 5: Image Compression Studio -->
                <TabItem Header="🖼️ Image Compression Studio">
                    <Grid Margin="0,10,0,0" DataContext="{Binding ImageCompression}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Compression Toolbar -->
                        <Border Grid.Row="0" Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Preset Picker -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Pattern:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                              Width="160" Height="26" Background="#1E2230" Foreground="#E2E8F0" FontSize="11"/>
                                </StackPanel>

                                <!-- Compression Slider -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="Truncated Rank (k): " FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding Rank}" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding MaxRank, StringFormat=' / {0}'}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Slider Minimum="1" Maximum="{Binding MaxRank}" Value="{Binding Rank, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </StackPanel>

                                <!-- Compression Badges -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="#064E3B" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding StorageSavingsText}" Foreground="#34D399" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding EnergyText}" Foreground="#F59E0B" FontSize="11"/>
                                    </Border>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="{Binding CompressionRatioText}" Foreground="#94A3B8" FontSize="11"/>
                                    </Border>
                                </StackPanel>

                                <!-- Load Image Button -->
                                <Button Grid.Column="3" Content="📂 Load Custom Image..." Command="{Binding LoadFileCommand}"
                                        Style="{StaticResource SecondaryButton}" Height="28"/>
                            </Grid>
                        </Border>

                        <!-- Side-by-Side Images -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Original Image Card -->
                            <Border Grid.Column="0" Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Original Grayscale Image Matrix" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding ResolutionText}" FontSize="10" Foreground="#38BDF8"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="6">
                                        <Image Source="{Binding OriginalBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="10"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Reconstructed Image Card -->
                            <Border Grid.Column="2" Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="SVD Rank-k Compressed Reconstruction" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Rank, StringFormat='k = {0}'}" FontSize="10" Foreground="#34D399" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="6">
                                        <Image Source="{Binding ReconstructedBitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="10"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 6: Mathematical Reference & Guide -->
                <TabItem Header="📖 Theory &amp; Math Reference">
                    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <Border Background="#161B26" BorderBrush="#2E364F" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock Text="Singular Value Decomposition (SVD) Reference" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                <TextBlock Text="1. Fundamental Theorem" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,10,0,4"/>
                                <TextBlock Text="For ANY real m × n matrix A, there exist orthogonal matrices U (m × m) and V (n × n), and an m × n matrix Σ with non-negative diagonal elements σ₁ ≥ σ₂ ≥ ... ≥ σₚ ≥ 0 (where p = min(m, n)) such that:"
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,8,0,12">
                                    <TextBlock Text="A = U · Σ · Vᵀ  =  Σ_{i=1}^r  σᵢ · uᵢ · vᵢᵀ"
                                               FontFamily="Cascadia Code, Consolas" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="2. Thin / Economy vs Full SVD" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,10,0,4"/>
                                <TextBlock Text="• Thin / Economy SVD: For an m × n matrix with m ≥ n, U is m × n, Σ is n × n, and Vᵀ is n × n. When m &lt; n, U is m × m, Σ is m × m, and Vᵀ is m × n. Discards redundant columns spanning null spaces."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <TextBlock Text="• Full SVD: U is m × m, Σ is m × n, and Vᵀ is n × n. For rank r, columns 1…r of U span Col(A) and columns r+1…m span Null(Aᵀ). Columns 1…r of V span Row(A), and columns r+1…n span Null(A). Numerical rank depends on the tolerance."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,2,0,12"/>

                                <TextBlock Text="3. Eckart-Young-Mirsky Theorem" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,10,0,4"/>
                                <TextBlock Text="The truncated sum A_k = Σ_{i=1}^k σᵢ uᵢ vᵢᵀ is the provably closest rank-k matrix to A in both the Frobenius norm and the Spectral norm. The minimum error is exactly:"
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,8,0,12">
                                    <TextBlock Text="||A - A_k||₂ = σ_{k+1}       and       ||A - A_k||_F = √(Σ_{i=k+1}^p σᵢ²)"
                                               FontFamily="Cascadia Code, Consolas" FontSize="13" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="4. Moore-Penrose Pseudo-Inverse" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,10,0,4"/>
                                <TextBlock Text="The exact pseudo-inverse is A⁺ = V · Σ⁺ · Uᵀ and gives the minimum-norm least-squares solution x = A⁺ b. This implementation inverts singular values above its numerical rank tolerance and discards the rest; it is a thresholded approximation when small non-zero values are discarded."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,2,0,12"/>

                                <TextBlock Text="5. Numerical Golub-Kahan-Reinsch Algorithm" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,10,0,4"/>
                                <TextBlock Text="This application uses a managed Golub-Kahan-Reinsch-style implementation; it does not call LAPACK.&#x0a;1. Householder reflections bidiagonalize A into upper bidiagonal form B = Pᵀ A Q.&#x0a;2. Backward accumulation forms U and V.&#x0a;3. Implicit shifted QR iterations reduce off-diagonal terms using floating-point deflation tests (ε ≈ 2.22 × 10⁻¹⁶). Accuracy depends on scale, dimensions, and conditioning."
                                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,2,0,12"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#161B26" BorderBrush="#2E364F" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ready" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <TextBlock Text="• Precision: 64-bit IEEE 754 Floating Point" Foreground="#64748B" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ComputeTimeMs, StringFormat='• Compute Time: {0:F2} ms'}" Foreground="#94A3B8" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Golub-Kahan-Reinsch SVD Engine" Foreground="#64748B" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
